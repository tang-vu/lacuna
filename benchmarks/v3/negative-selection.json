{
  "schema_version": 1,
  "status": "frozen_before_v3_metric",
  "frozen_on": "2026-07-31",
  "metric_blind": true,
  "readiness_contribution": "zero_until_human_adjudication_and_case_acceptance",
  "seed": "lacuna-v3-negative-controls-2026-07-31",
  "source_vocabulary_years": [
    2012,
    2013
  ],
  "common_descriptor_rule": {
    "descriptor_class": "1",
    "require_exactly_one_tree_number": true,
    "minimum_tree_depth": 3,
    "excluded_top_level_branches": [
      "V",
      "Z"
    ]
  },
  "hard_negative": {
    "definition": "Two distinct descriptors with the same immediate MeSH tree parent are ontology-adjacent confounders, not candidate discoveries.",
    "allowed_top_level_branches": [
      "A",
      "B",
      "C",
      "D",
      "E",
      "F",
      "G"
    ],
    "minimum_sibling_group_size": 2,
    "maximum_sibling_group_size": 12,
    "pairs_per_year": 4,
    "selection": "hash_sort_all_eligible_pairs_then_greedily_take_pairs_without_reusing_descriptors"
  },
  "distant_negative": {
    "definition": "Descriptors are drawn from fixed disjoint top-level MeSH branches; semantic distance is a review hypothesis, not proof that no relationship exists.",
    "branch_strata": [
      ["A", "J"],
      ["B", "F"],
      ["C", "H"],
      ["D", "I"]
    ],
    "pairs_per_stratum_per_year": 1,
    "selection": "independently_hash_sort_each_branch_with_stratum_specific_salts_then_take_the_first_unused_descriptor"
  },
  "split_assignment": {
    "method": "alternate_within_each_year_and_kind_after_deterministic_selection",
    "first_split": "development",
    "required_totals_per_kind": {
      "development": 4,
      "heldout": 4
    }
  },
  "cutoff_assignment": "release_year_minus_one_on_december_31",
  "review_policy": {
    "generated_entries_are_proposals": true,
    "acceptance_requires_public_metric_blind_negative_rationale": true,
    "absence_of_academic_cooccurrence_is_not_evidence_of_absent_human_knowledge": true,
    "metric_scores_ranks_and_percentiles_are_forbidden": true
  }
}
